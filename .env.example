# Public site URL (used for metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://pixie-dust-cheesecake.vercel.app

# Session signing for Sign up / Log in (required in production)
AUTH_SECRET=replace-with-a-long-random-string

# Placement lead notified on partner intro requests (logged; wire email/webhook in prod)
PLACEMENT_LEAD_EMAIL=placement@example.com

# Optional webhook that receives intro JSON payloads
# INTRO_WEBHOOK_URL=https://example.com/hooks/intro

# Live AI providers
# OPENAI_API_KEY=           # chat + DALL·E images
# KIMI_API_KEY=             # Moonshot/Kimi chat (fallback or alternate)
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=moonshot-v1-8k
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=dall-e-3
# REPLICATE_API_TOKEN=      # optional images / video models
# RUNWAY_API_KEY=           # optional video generation
